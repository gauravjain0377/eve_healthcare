# Application Settings
PROJECT_NAME="EVE Healthcare API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="eve_secret_jwt_key_super_secure_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL (Docker or local):
# DATABASE_URL=postgresql://eve_user:eve_password@localhost:5432/eve_db
# For SQLite (instant local development without DB setup):
DATABASE_URL=sqlite:///./eve_healthcare.db

# Redis Caching (Falls back to in-memory cache if offline)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=300

# Webhook Security
WEBHOOK_SECRET="whsec_simulated_eve_secret_key_8921"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
